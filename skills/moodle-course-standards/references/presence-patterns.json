{
  "comment": "Row number to search pattern for the Section 2 presence rules. Patterns are case insensitive regexes matched one at a time against section names and summaries, module names and descriptions, and file names in the visible intro sections (section 0 and any section named like start here, getting started, orientation, about, administration, welcome or general). A match is Yes. 'not_with' skips text that also matches it, and 'names_only' searches section and module names only. With no match, 'syllabus' lists keywords that make the row Somewhat when found in the syllabus: the reviewer's standard is on the page Yes, only in the syllabus Somewhat, neither No.",
  "patterns": {
    "17": {
      "label": "Course Syllabus Document",
      "pattern": "syllab"
    },
    "18": {
      "label": "Course Outline/Schedule Document",
      "pattern": "outline|schedule|calendar|course at a glance",
      "not_with": "syllab",
      "syllabus": [
        "schedule",
        "course calendar",
        "week 1"
      ]
    },
    "19": {
      "label": "Course overview/introduction",
      "pattern": "overview|introduction to the course|course intro",
      "not_with": "syllab",
      "syllabus": [
        "course description",
        "catalog description",
        "course overview"
      ]
    },
    "20": {
      "label": "Instructor/TA welcome video, audio or message",
      "pattern": "welcome|meet your instructor|meet the professor"
    },
    "21": {
      "label": "Instructor/TA bio with contact information",
      "pattern": "instructor (info|information|bio)|about (the|your) (instructor|professor)|meet (the|your) (instructor|professor)|\\bbio\\b|contact (info|information)|faculty profile",
      "syllabus": [
        "instructor",
        "professor"
      ]
    },
    "22": {
      "label": "Course Navigation",
      "pattern": "navigat|course tour|getting started|how this course|start here",
      "names_only": true
    },
    "23": {
      "label": "Communication Guidelines",
      "pattern": "communicat|netiquette|discussion guideline|email polic",
      "syllabus": [
        "communicat",
        "netiquette",
        "response time",
        "email"
      ]
    },
    "24": {
      "label": "Course Technology",
      "pattern": "technology requirement|system requirement|minimum requirement|required technology|computer requirement|hardware",
      "syllabus": [
        "technology requirement",
        "required technology",
        "computer requirement",
        "reliable internet",
        "webcam"
      ]
    },
    "25": {
      "label": "Student Office hours information",
      "pattern": "office hour|student hour|drop.?in",
      "syllabus": [
        "office hours",
        "student hours",
        "by appointment"
      ]
    },
    "26": {
      "label": "Link to Academic Support",
      "pattern": "academic support|\\btutor(ing)?\\b|writing center|library|academic success|counsel",
      "syllabus": [
        "library",
        "tutor",
        "writing center",
        "academic success"
      ]
    },
    "27": {
      "label": "Course and Tech support",
      "pattern": "tech support|help ?desk|moodle support|wolftech|it support|ncsu support",
      "syllabus": [
        "tech support",
        "help desk",
        "helpdesk",
        "wolftech",
        "moodle support",
        "919-515-help"
      ]
    }
  }
}
